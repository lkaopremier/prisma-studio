# Single database
DATABASE_URL=postgresql://user:password@host:5432/mydb

# Multiple databases: pipe-separated URLs
# DATABASE_URL=postgresql://user:password@host:5432/production|mysql://user:password@host:3306/staging

# Multiple databases with custom labels (Label::url)
# DATABASE_URL=Production::postgresql://user:password@host:5432/mydb|Staging::mysql://user:password@host:3306/staging

AUTH_USER=admin
AUTH_PASSWORD=changeme
SESSION_SECRET=a-long-random-secret
# SESSION_MAX_AGE=28800000  # session duration in ms (default: 8h)
# SECURE_COOKIE=true        # enable when behind HTTPS reverse proxy (Coolify)
