# Single database
DATABASE_URL=postgresql://user:password@host:5432/mydb

# Multiple databases: pipe-separated URLs (names are auto-detected)
# DATABASE_URL=postgresql://user:password@host:5432/production|mysql://user:password@host:3306/staging

AUTH_USER=admin
AUTH_PASSWORD=changeme
SESSION_SECRET=a-long-random-secret
# SECURE_COOKIE=true   # enable when behind HTTPS reverse proxy (Coolify)
